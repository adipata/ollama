# systemd user unit. Install:
#   mkdir -p ~/.config/systemd/user && cp deploy/ollama-vllm-proxy.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now ollama-vllm-proxy
# It must run as the user who owns the SSH key used for the pod.
[Unit]
Description=Ollama-compatible proxy in front of vLLM
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/ollama-vllm-proxy
# Optional settings (PROXY_PORT, DATA_DIR, ...); see README.
EnvironmentFile=-%h/ollama-vllm-proxy/.env
ExecStart=%h/ollama-vllm-proxy/.venv/bin/ollama-vllm-proxy serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
